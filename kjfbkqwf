/* ---- preview clip (video + recitation audio) ---- */
let unlocked=false;
function syncClip(t){
  const v=E.clip; if(!v||v.readyState<2)return;
  const ph=clipPhase(t); const run=_playing&&t>=PREV_START&&t<PLAY_END;
  const wantSound=_playing&&t>=PLAY_START&&t<PLAY_END&&unlocked;
  if(v.muted===wantSound) v.muted=!wantSound;
  if(run){
    if(v.paused){ try{v.currentTime=ph}catch(e){} v.play().catch(()=>{v.muted=true; v.play().catch(()=>{})}) }
    else if(Math.abs(v.currentTime-ph)>.22 && !(ph<.4&&v.currentTime>CLIPDUR-.5)) { try{v.currentTime=ph}catch(e){} }
  } else { if(!v.paused)v.pause(); if(Math.abs(v.currentTime-ph)>.04){ try{v.currentTime=ph}catch(e){} } }
}

/* ================= SOUND DESIGN =================
   Replace the harsh pre-rendered effects with quiet, premium UI cues.
   The Quran recitation remains the only backing audio during the caption preview. */
let sfxOn=true, sfxCtx=null, firedSfx=new Set();
const SFX_CUES=[
  [7.95,"whoosh"],[8.34,"tap"],[10.18,"tap"],[12.38,"tap"],
  [15.55,"tap"],[18.65,"tick"],[21.0,"tap"],[22.62,"whoosh"],
  [27.72,"success"],[28.28,"tap"],[39.55,"success"]
];
function audioContext(){
  if(!sfxCtx){const AC=window.AudioContext||window.webkitAudioContext;if(AC)sfxCtx=new AC()}
  if(sfxCtx&&sfxCtx.state==="suspended")sfxCtx.resume().catch(()=>{});
  return sfxCtx;
}
function tone(freq,start,duration,volume,type="sine",endFreq=freq){
  const c=audioContext();if(!c)return;
  const o=c.createOscillator(),g=c.createGain();
  o.type=type;o.frequency.setValueAtTime(freq,start);o.frequency.exponentialRampToValueAtTime(Math.max(20,endFreq),start+duration);
  g.gain.setValueAtTime(.0001,start);g.gain.exponentialRampToValueAtTime(Math.max(.0002,volume),start+.012);g.gain.exponentialRampToValueAtTime(.0001,start+duration);
  o.connect(g);g.connect(c.destination);o.start(start);o.stop(start+duration+.02);
}
function softNoise(start,duration,volume){
  const c=audioContext();if(!c)return;
  const n=Math.max(1,Math.floor(c.sampleRate*duration)),buf=c.createBuffer(1,n,c.sampleRate),d=buf.getChannelData(0);
  for(let i=0;i<n;i++)d[i]=(Math.random()*2-1)*(1-i/n);
  const src=c.createBufferSource(),filter=c.createBiquadFilter(),g=c.createGain();
  src.buffer=buf;filter.type="lowpass";filter.frequency.value=950;g.gain.setValueAtTime(.0001,start);g.gain.linearRampToValueAtTime(volume,start+.04);g.gain.exponentialRampToValueAtTime(.0001,start+duration);
  src.connect(filter);filter.connect(g);g.connect(c.destination);src.start(start);src.stop(start+duration);
}
function playCue(kind){
  const c=audioContext();if(!c)return;const now=c.currentTime;
  if(kind==="tap"){tone(1250,now,.045,.025,"sine",820);tone(680,now+.012,.055,.012,"sine",520)}
  else if(kind==="tick"){tone(1450,now,.035,.012,"sine",1100)}
  else if(kind==="whoosh"){softNoise(now,.24,.025);tone(320,now,.22,.009,"sine",620)}
  else if(kind==="success"){tone(784,now,.22,.025,"sine",784);tone(988,now+.08,.28,.022,"sine",988);tone(1175,now+.17,.36,.018,"sine",1175)}
}
function sfxSync(prev,t,playing){
  if(!playing){firedSfx.clear();return}
  if(!sfxOn||!unlocked)return;
  // Avoid sound effects over the Quran recitation itself.
  if(t>=PLAY_START&&prev<PLAY_END)return;
  for(const cue of SFX_CUES){if(cue[0]>prev&&cue[0]<=t&&!firedSfx.has(cue[0])){playCue(cue[1]);firedSfx.add(cue[0])}}
}

/* ================= VOICEOVER (queued — a line is never cut off by the next one) ================= */
const VO=[
 [.3,"Captioning a Quran recitation by hand takes hours."],
 [3.8,"Meet Talween AI, your AI Quran captions generator."],
 [7.7,"Tap Add media, and choose your video."],
 [12.0,"Tap Add captions to open the preview."],
 [15.5,"Choose how many words each caption covers, from one up to one hundred forty five."],
 [20.9,"We'll pick four, turn on the translation, and tap Create captions."],
 [25.0,"Talween AI aligns every word to the recitation."],
 [28.4,"Here's your preview, with translation."],
 [39.9,"Talween AI. Quran captions, made effortless."]];
let voOn=true, voFile=false; const voAudio=new Audio(); let voice=null;
function pickVoice(){
  if(!window.speechSynthesis)return null;
  const vs=speechSynthesis.getVoices().filter(v=>/^en/i.test(v.lang)); if(!vs.length)return null;
  const rank=v=>{let s=0; if(/natural|neural|premium|enhanced/i.test(v.name))s+=50; if(/google uk english male|daniel|aaron|alex|oliver|guy|ryan|david|arthur|samantha|ava|allison/i.test(v.name))s+=20; if(/en-GB|en-US/i.test(v.lang))s+=5; if(v.localService===false)s+=3; return s};
  return vs.sort((a,b)=>rank(b)-rank(a))[0];
}
if(window.speechSynthesis){speechSynthesis.onvoiceschanged=()=>{voice=pickVoice()}; voice=pickVoice()}
function speak(text){
  if(!window.speechSynthesis)return; const u=new SpeechSynthesisUtterance(text); if(!voice)voice=pickVoice(); if(voice)u.voice=voice; u.lang=(voice&&voice.lang)||"en-US"; u.rate=1.02; u.pitch=.92; u.volume=1;
  speechSynthesis.speak(u);   // queued: waits for the previous line to finish instead of cancelling it
}
function voStep(prev,t,playing){
  if(!voOn)return;
  if(voFile){
    if(playing&&unlocked){ if(voAudio.paused||Math.abs(voAudio.currentTime-t)>.4){voAudio.currentTime=t; voAudio.play().catch(()=>{})} } else if(!voAudio.paused) voAudio.pause();
    return;
  }
  if(!window.speechSynthesis)return;
  if(!playing){ if(speechSynthesis.speaking&&!speechSynthesis.paused)speechSynthesis.pause(); return }
  if(speechSynthesis.paused)speechSynthesis.resume();
  if(Math.abs(t-prev)>.3){speechSynthesis.cancel(); return}
  VO.forEach(l=>{ if(l[0]>prev&&l[0]<=t){ if(t>=PLAY_START-.3&&t<PLAY_END)return; speak(l[1]) } });
}
function voStop(){ try{speechSynthesis.cancel()}catch(e){} voAudio.pause() }

/* ================= ENGINE ================= */
let T=0,playing=false,_playing=false,last=performance.now();
function render(t){update(t); $("seek").value=t/TOTAL*1000; $("tt").textContent="0:"+String(Math.floor(t)).padStart(2,"0")+" / 0:"+TOTAL}
function loop(now){
  const dt=Math.min(.1,(now-last)/1000); last=now; const prev=T;
  if(playing){T+=dt; if(T>=TOTAL){T=TOTAL;playing=false;$("pp").textContent="Replay"}}
  _playing=playing; sfxSync(prev,T,playing); voStep(prev,T,playing); render(T); requestAnimationFrame(loop);
}
function start(){ unlocked=true; $("vplay").style.display="none"; if(T>=TOTAL){T=0;voStop()} playing=true; $("pp").textContent="Pause" }
$("vplay").onclick=start;
$("pp").onclick=()=>{ unlocked=true; if(!playing){ start() } else { playing=false; $("pp").textContent="Play" } };
$("rs").onclick=()=>{voStop();T=0;start()};
$("seek").oninput=e=>{unlocked=true;T=e.target.value/1000*TOTAL;playing=false;voStop();$("vplay").style.display="none";$("pp").textContent="Play"};
$("snd").onclick=()=>{sfxOn=!sfxOn; $("snd").textContent=sfxOn?"✨ Soft SFX on":"🔇 SFX off"};
$("vob").onclick=()=>{voOn=!voOn; $("vob").textContent=voOn?"🗣 Voiceover on":"🔇 Voiceover off"; if(!voOn)voStop()};
$("vof").onclick=()=>$("vofile").click();
$("vofile").onchange=e=>{const f=e.target.files[0]; if(!f)return; voAudio.src=URL.createObjectURL(f); voFile=true; voOn=true; voStop(); $("vof").textContent="🎙 My VO loaded"; $("vob").textContent="🗣 Voiceover on"};
addEventListener("keydown",e=>{if(e.code==="Space"){e.preventDefault();$("pp").click()}});
function fit(){const w=Math.min(innerWidth-16,1100,(innerHeight-110)*16/9),h=w*9/16; const vp=$("viewport"); vp.style.width=w+"px"; vp.style.height=h+"px"; $("stage").style.transform=`scale(${w/1920})`}
addEventListener("resize",fit); fit();
requestAnimationFrame(t=>{last=t;loop(t)});
</script>
